# NestJS API — Environment Variables

# Database (Aiven PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Redis (Upstash — use rediss:// for TLS)
REDIS_URL=rediss://:password@hostname:6379

# Upstash alert set at 7500 cmds/day (75% of 10k quota)
# Configure in Upstash console: Redis database → Alerts → Daily Commands → 7500 → email

# Port (optional — defaults to 3010)
PORT=3010

# Google Places API (New) — IDs Only tier for Text Search = unlimited free commercial
# Get key at: https://console.cloud.google.com/google/maps-apis/
# Enable: "Places API (New)" — Text Search + Place Details Essentials
GOOGLE_PLACES_API_KEY=your_key_here

# BRouter (POI Access Routing)
# NestJS PM2 natif accède à BRouter Docker via localhost (dev et prod)
BROUTER_BASE_URL=http://localhost:17777
# Timeout pour les requêtes BRouter (ms)
BROUTER_TIMEOUT_MS=5000
# Profil de routage par défaut
BROUTER_DEFAULT_PROFILE=trekking

# Access calculation (POI Access Routing)
# Seuil eager : distance max (m) pour calcul immédiat vs async
ACCESS_EAGER_THRESHOLD_M=1500
# Buffer autour de la trace GPX (m) pour le snap du POI
ACCESS_TRACE_BUFFER_M=10
# Version moteur de calcul (tag pour invalidation cache).
# Bumper cette valeur invalide TOUS les accès en cache → recalcul lazy.
# v2 (2026-05-30) : mapping profils road→fastbike/gravel→gravel/bikepacking→trekking
# + origine d'accès = point de trace le plus proche du POI (au lieu du départ d'aventure).
ACCESS_ENGINE_VERSION=brouter-1.7.9+profiles-v2

HEALTH_ENDPOINT_TOKEN="changeme-openssl-rand-hex-24"
BULL_BOARD_ENABLED=false
BULL_BOARD_USER="admin"
BULL_BOARD_PASSWORD="changeme-strong-password"
